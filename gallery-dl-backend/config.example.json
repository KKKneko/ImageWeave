{
  "runtime_dir": "runtime",
  "database_path": "runtime/backend.sqlite3",
  "default_output_root": "runtime/downloads",
  "allowed_output_roots": [
    "runtime/downloads"
  ],
  "allowed_config_roots": [
    "credentials"
  ],
  "allowed_cookie_roots": [
    "credentials"
  ],
  "server": {
    "host": "127.0.0.1",
    "port": 8787,
    "cors_origins": [],
    "allow_private_targets": false,
    "strict_target_dns": true
  },
  "encrypted_dns": {
    "enabled": true,
    "endpoint": "https://cloudflare-dns.com/dns-query",
    "timeout_seconds": 8,
    "max_response_bytes": 65536
  },
  "gallery": {
    "repo_path": "../gallery-dl-codeberg",
    "cache_file": "credentials/managed/gallery-dl-cache.sqlite3",
    "python_executable": "",
    "migrate_default_auth": true,
    "default_http_timeout": 30,
    "default_retries": 2,
    "terminate_grace_seconds": 5,
    "max_log_line_chars": 4000
  },
  "auth": {
    "chrome_executable": "",
    "browser_login_timeout_seconds": 900,
    "browser_poll_interval_seconds": 1,
    "authorization_proxy": ""
  },
  "proxy": {
    "enabled": false,
    "auto_start": false,
    "engine": "native",
    "subscription_urls": [],
    "node_file": "",
    "inline_nodes": [],
    "allowed_node_roots": [
      "../subscriptions"
    ],
    "allow_socks": true,
    "probe_url": "https://example.com/",
    "probe_timeout_seconds": 10,
    "probe_workers": 32,
    "probe_cache_ttl_seconds": 600.0,
    "health_interval_seconds": 60,
    "fail_cooldown_seconds": 30,
    "subscription_timeout_seconds": 20,
    "transport_core_enabled": true,
    "transport_core_base_port": 29000,
    "transport_core_start_timeout_seconds": 15
  },
  "scheduler": {
    "max_concurrent_tasks": 20,
    "max_concurrent_batches": 4,
    "poll_interval_seconds": 0.5,
    "shutdown_grace_seconds": 15,
    "max_logs_per_task": 5000,
    "retry_jitter_seconds": 0.5
  },
  "dedup": {
    "enabled": false,
    "python_executable": "",
    "worker_script": "../dedup_review_worker.py",
    "core_script": "../dedup_core.py",
    "model_dir": "../.models",
    "device": "auto",
    "workers": 0,
    "torch_threads": 0,
    "torch_interop_threads": 0,
    "deep_batch_size": 0,
    "neighbor_block_size": 0,
    "poll_interval_seconds": 1,
    "shutdown_grace_seconds": 10,
    "no_sscd": false,
    "no_dino": false
  },
  "default_site_policy": {
    "max_concurrency": 20,
    "retry_limit": 2,
    "backoff_base_seconds": 2,
    "proxy_mode": "prefer"
  }
}
